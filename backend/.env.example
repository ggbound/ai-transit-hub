# Server Configuration
SERVER_PORT=8080
GIN_MODE=debug

# Log Configuration
LOG_PATH=./logs
# Log Level: DEBUG, INFO, WARN, ERROR, FATAL
LOG_LEVEL=INFO

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_transit_hub
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-this-in-production
JWT_EXPIRY=24h

# Application Configuration
APP_NAME=AI Transit Hub
APP_ENV=development

# Skill Storage Configuration (SKILL.md 技能包附件存储目录)
SKILL_STORAGE_PATH=./storage/skills

# Agent Task Storage Configuration
# AGENT_TASK_STORAGE_PATH：虚拟 Agent 任务工作区根目录（产出资产按 task_id 归档）
AGENT_TASK_STORAGE_PATH=./storage/agent_tasks

# Agent Runtime Configuration
# AGENT_ALLOW_WORKSPACE_SCRIPT：是否允许 execute_script 执行任务工作区内自建脚本（默认 false）
# 开启后脚本经沙箱后端自适应链执行；无可用沙箱时默认 plain 直跑兜底（见下方 Agent Sandbox Backend）
AGENT_ALLOW_WORKSPACE_SCRIPT=false
# AGENT_ROUTER_MODEL：dispatch 语义路由模型，兼作无显式 model 时的兜底执行模型（provider/model）
AGENT_ROUTER_MODEL=

# Agent Python Environment Isolation（Python 执行环境隔离）
# AGENT_PY_ENV_MODE：python 脚本执行环境模式
#   system = 宿主系统 python3（默认，历史行为）
#   venv   = 按任务构建隔离虚拟环境（uv 引导 + 托管 CPython，环境位于 AGENT_PY_ENV_ROOT，
#            沙箱内只读挂载，任务间互不可见；技能 frontmatter 声明 pip: 包名自动装入）
AGENT_PY_ENV_MODE=system
# 以下仅在 venv 模式下生效：
# AGENT_PY_VERSION：托管 CPython 版本（uv python install，默认 3.12）
#AGENT_PY_VERSION=3.12
# AGENT_UV_VERSION：uv 工具链版本（钉住，保证构建可复现，默认 0.13.5）
#AGENT_UV_VERSION=0.13.5
# AGENT_UV_DOWNLOAD_URL：覆盖 uv 下载地址（自建镜像用；默认官方 releases.astral.sh）
#AGENT_UV_DOWNLOAD_URL=
# AGENT_UV_SHA256：指定 uv 压缩包 sha256（自建镜像必填；默认自动拉取官方 .sha256 旁挂文件）
#AGENT_UV_SHA256=
# AGENT_PYPI_INDEX_URL：PyPI 兼容索引（UV_DEFAULT_INDEX；默认官方 pypi.org）
#AGENT_PYPI_INDEX_URL=
# AGENT_PYTHON_INSTALL_MIRROR：CPython 独立构建镜像（UV_PYTHON_INSTALL_MIRROR）
#AGENT_PYTHON_INSTALL_MIRROR=
# AGENT_PY_ENV_ROOT：任务 Python 环境根目录（默认 <AGENT_TASK_STORAGE_PATH>/_pyenvs）
#AGENT_PY_ENV_ROOT=
# AGENT_PY_INSTALL_TIMEOUT：单任务环境构建总超时（默认 5m；首次含 uv+CPython 下载约 30s）
#AGENT_PY_INSTALL_TIMEOUT=5m
# AGENT_PY_WHEELS_ONLY：仅允许 wheel 安装（默认 true，禁 sdist 防安装期任意代码执行）
#AGENT_PY_WHEELS_ONLY=true
# AGENT_PY_ENV_TTL：任务 venv TTL 清理循环的兜底阈值（默认 168h=7 天；0=不清理）。
# 正常路径任务结束即删除该任务 venv，此 TTL 仅兜底服务崩溃等漏删的孤儿环境
#AGENT_PY_ENV_TTL=168h

# Agent Sandbox Backend（execute_script 沙箱后端自适应链）
# AGENT_SANDBOX_BACKEND：后端选择策略
#   auto    = 按宿主环境构造候选链并逐个探测取首个可用后端（默认）：
#             darwin → seatbelt（sandbox-exec）；linux → bwrap（bubblewrap）；
#             docker → 配置了 AGENT_SANDBOX_IMAGE 才参与；plain → 默认参与作链末位兜底（ALLOW_PLAIN=false 关闭）
#   seatbelt / bwrap / docker / plain = 显式锁定单一后端（不可用时 fail-closed 拒绝执行，不静默降级）
# 沙箱后端（seatbelt/bwrap/docker）均提供一致边界：禁网、写入仅限任务工作区与临时目录、读侧屏蔽宿主机敏感路径；
# plain 后端无隔离直跑（仅保留超时与输出截断），仅作 auto 链末位兜底
AGENT_SANDBOX_BACKEND=auto
# AGENT_SANDBOX_IMAGE：docker 后端执行镜像（如 python:3.12-slim；空=docker 后端不参与链）。
# 镜像内需自带脚本所需解释器/依赖（跨环境一致性由镜像保证）；
# 注意：venv 模式下 docker 后端仅 Linux 宿主可用（托管 CPython 按宿主 OS 构建，跨 OS 容器内无法运行）
#AGENT_SANDBOX_IMAGE=
# AGENT_SANDBOX_ALLOW_PLAIN：是否允许无沙箱直跑作为链末位兜底（默认 true：
# 全部沙箱后端不可用时直跑，仅保留超时与输出截断，保证任务不中断；
# 安全优先部署可设为 false——此时无可用后端将拒绝执行而非降级）
AGENT_SANDBOX_ALLOW_PLAIN=true
